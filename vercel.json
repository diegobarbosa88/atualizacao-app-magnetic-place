{
  "functions": {
    "api/gmail/import-faturas.js": {
      "maxDuration": 60,
      "includeFiles": "node_modules/pdf-parse/dist/**"
    },
    "api/parse-fatura.js": {
      "maxDuration": 30
    },
    "api/reconciliacao/index.js": {
      "maxDuration": 60
    },
    "api/toconline/create-fatura.js": {
      "maxDuration": 30
    },
    "api/toconline/proxy.js": {
      "maxDuration": 30
    },
    "api/contador/index.js": {
      "maxDuration": 60,
      "includeFiles": "node_modules/pdf-parse/dist/**"
    },
    "api/pagamentos/index.js": {
      "maxDuration": 30
    },
    "api/seguranca-social/index.js": {
      "maxDuration": 30
    }
  },
  "crons": [
    { "path": "/api/contador?tipo=preparar_mensal", "schedule": "0 9 5 * *" },
    { "path": "/api/formacao?action=lembrete-validacao", "schedule": "0 8 * * *" }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/workbox-(.*).js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/version.json",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/reconciliacao/parse", "destination": "/api/reconciliacao?tipo=parse" },
    { "source": "/api/reconciliacao/upload", "destination": "/api/reconciliacao?tipo=upload" },
    { "source": "/api/reconciliacao/process", "destination": "/api/reconciliacao?tipo=process" },
    { "source": "/api/contador-acesso", "destination": "/api/contador?tipo=acesso" },
    { "source": "/api/contador-resumo", "destination": "/api/contador?tipo=resumo" },
    { "source": "/api/gerar-resposta-contador", "destination": "/api/contador?tipo=gerar" },
    { "source": "/api/aprovar-resposta-contador", "destination": "/api/contador?tipo=aprovar" },
    { "source": "/api/apagar-email-contador", "destination": "/api/contador?tipo=apagar" },
    { "source": "/api/toconline/bank-accounts", "destination": "/api/toconline/proxy?action=bank-accounts" },
    { "source": "/api/toconline/clientes", "destination": "/api/toconline/proxy?action=clientes" },
    { "source": "/api/toconline/fornecedores", "destination": "/api/toconline/proxy?action=fornecedores" },
    { "source": "/api/toconline/relatorio", "destination": "/api/toconline/proxy?action=relatorio" },
    { "source": "/api/toconline/status", "destination": "/api/toconline/proxy?action=status" },
    { "source": "/api/toconline/auth-init", "destination": "/api/toconline/proxy?action=auth-init" },
    { "source": "/api/toconline/token-exchange", "destination": "/api/toconline/proxy?action=token-exchange" },
    { "source": "/api/formacao/list", "destination": "/api/formacao?action=list" },
    { "source": "/api/formacao/create", "destination": "/api/formacao?action=create" },
    { "source": "/api/formacao/atribuir", "destination": "/api/formacao?action=atribuir" },
    { "source": "/api/formacao/sign", "destination": "/api/formacao?action=sign" },
    { "source": "/api/formacao/minhas", "destination": "/api/formacao?action=minhas" },
    { "source": "/api/formacao/iniciar", "destination": "/api/formacao?action=iniciar" },
    { "source": "/api/formacao/responder-questionario", "destination": "/api/formacao?action=responder-questionario" },
    { "source": "/api/formacao/conteudo", "destination": "/api/formacao?action=conteudo" },
    { "source": "/api/formacao/certificacoes", "destination": "/api/formacao?action=certificacoes" },
    { "source": "/api/formacao/requisitos", "destination": "/api/formacao?action=requisitos" },
    { "source": "/api/formacao/requisitos-set", "destination": "/api/formacao?action=requisitos-set" },
    { "source": "/api/formacao/auto-atribuir", "destination": "/api/formacao?action=auto-atribuir" },
    { "source": "/api/formacao/horas-por-trabalhador", "destination": "/api/formacao?action=horas-por-trabalhador" },
    { "source": "/api/push/send", "destination": "/api/formacao?action=push-send" },
    { "source": "/api/whatsapp", "destination": "/api/salarios/exportar-sepa" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
